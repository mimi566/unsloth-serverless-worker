{
  "title": "Unsloth LLM Worker",
  "description": "Deploy OpenAI-compatible LLM endpoints powered by Unsloth",
  "type": "serverless",
  "category": "language",
  "iconUrl": "https://registry.npmmirror.com/@lobehub/icons-static-png/latest/files/dark/vllm-color.png",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 50,
    "gpuIds": "ADA_80_PRO,AMPERE_80",
    "gpuCount": 1,
    "allowedCudaVersions": ["12.9", "12.8", "12.7", "12.6", "12.5", "12.4"],
    "env": [
      {
        "key": "MODEL_NAME",
        "input": {
          "name": "Model",
          "type": "huggingface",
          "description": "Hugging Face model name",
          "required": true
        }
      },
      {
        "key": "TOKENIZER_NAME",
        "input": {
          "name": "Tokenizer",
          "type": "string",
          "description": "Tokenizer repo to use a different tokenizer than the model's default",
          "advanced": true
        }
      },
      {
        "key": "HF_TOKEN",
        "input": {
          "name": "Hugging Face Token",
          "type": "string",
          "description": "Hugging Face access token",
          "advanced": true
        }
      },
      {
        "key": "QUANTIZATION",
        "input": {
          "name": "Quantization",
          "type": "string",
          "description": "Quantization method for model weights",
          "options": [
            { "label": "None", "value": "None" },
            { "label": "AWQ", "value": "awq" },
            { "label": "SqueezeLLM", "value": "squeezellm" },
            { "label": "GPTQ", "value": "gptq" }
          ],
          "advanced": true
        }
      },
      {
        "key": "GPU_MEMORY_UTILIZATION",
        "input": {
          "name": "GPU Memory Utilization",
          "type": "number",
          "description": "Fraction of GPU VRAM to use",
          "default": 0.92,
          "advanced": true
        }
      },
      {
        "key": "MAX_MODEL_LEN",
        "input": {
          "name": "Max Model Length",
          "type": "number",
          "description": "Context length for the model",
          "advanced": true
        }
      },
      {
        "key": "DEFAULT_BATCH_SIZE",
        "input": {
          "name": "Default Final Batch Size",
          "type": "number",
          "description": "Batch size for token streaming",
          "default": 50,
          "advanced": true
        }
      },
      {
        "key": "DEFAULT_MIN_BATCH_SIZE",
        "input": {
          "name": "Default Starting Batch Size",
          "type": "number",
          "description": "Initial batch size for requests",
          "default": 1,
          "advanced": true
        }
      },
      {
        "key": "DEFAULT_BATCH_SIZE_GROWTH_FACTOR",
        "input": {
          "name": "Default Batch Size Growth Factor",
          "type": "number",
          "description": "Growth factor for dynamic batching",
          "default": 3,
          "advanced": true
        }
      },
      {
        "key": "BASE_PATH",
        "input": {
          "name": "Base Path",
          "type": "string",
          "description": "Storage directory for Huggingface cache and model",
          "default": "/runpod-volume",
          "advanced": true
        }
      }
    ]
  }
}
